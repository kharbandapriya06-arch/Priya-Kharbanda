# Get a free access key at https://web3forms.com
# The contact API reads this on the server. It is sent to the browser only after the form is accepted.
# WEB3FORMS_ACCESS_KEY is preferred. NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY still works.
WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Used for metadata, sitemap, and Open Graph URLs.
# Set this to your production domain after deploying to Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
